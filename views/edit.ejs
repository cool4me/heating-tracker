<!DOCTYPE html>
<html lang="el">
<head>
    <meta charset="UTF-8">
    <title>Επεξεργασία Καταχώρησης</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light pb-5">
    <div class="container mt-5" style="max-width: 600px;">
        <div class="card p-4 shadow-sm">
            <h2 class="mb-4 text-center">✏️ Επεξεργασία Καταχώρησης</h2>
            <form action="/edit/<%= log._id %>" method="POST" class="row g-3">
                <div class="col-12">
                    <label class="form-label">Ημερομηνία</label>
                    <input type="date" name="date" class="form-control" required value="<%= log.date ? new Date(log.date).toISOString().split('T')[0] : '' %>">
                </div>
                <div class="col-12">
                    <label class="form-label">Είδος Καυσίμου</label>
                    <input type="text" name="unit" class="form-control" required value="<%= log.unit %>">
                </div>
                <div class="col-12">
                    <label class="form-label">Ποσότητα (Kg / Λίτρα)</label>
                    <input type="number" step="any" name="amount" class="form-control" value="<%= log.amount %>">
                </div>
                <div class="col-12">
                    <label class="form-label">Συνολικό Κόστος (€)</label>
                    <input type="number" step="any" name="totalCost" class="form-control" value="<%= log.totalCost %>">
                </div>
                <div class="col-12">
                    <label class="form-label">Σημειώσεις / Λεπτομέρειες</label>
                    <input type="text" name="notes" class="form-control" value="<%= log.notes %>">
                </div>
                <div class="col-12 d-flex justify-content-between mt-4">
                    <a href="/" class="btn btn-secondary">Ακύρωση</a>
                    <button type="submit" class="btn btn-success">Αποθήκευση Αλλαγών</button>
                </div>
            </form>
        </div>
    </div>
</body>
</html>