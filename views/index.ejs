<!DOCTYPE html>
<html lang="el">
<head>
    <meta charset="UTF-8">
    <title>Καταγραφή Καυσίμων Θέρμανσης</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light pb-5">
    <div class="container mt-4">
        <h1 class="mb-4 text-center">🔥 Καταγραφή Καυσίμων Θέρμανσης</h1>

        <!-- Κουμπιά Επιλογής Χρονιάς & Καυσίμου -->
        <div class="card mb-4 p-3 shadow-sm">
            <h5 class="mb-3">📅 Επιλέξτε Χρονιά:</h5>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <a href="/?<%= selectedFuel ? 'fuel=' + selectedFuel : '' %>" class="btn <%= !selectedYear ? 'btn-secondary' : 'btn-outline-secondary' %> btn-sm">Όλα τα έτη</a>
                <% years.forEach(y => { %>
                    <a href="/?<%= selectedFuel ? 'fuel=' + selectedFuel + '&' : '' %>year=<%= y %>" 
                       class="btn <%= selectedYear == y ? 'btn-success' : 'btn-outline-success' %> btn-sm">
                        <%= y %>
                    </a>
                <% }) %>
            </div>

            <h5 class="mb-3">🔥 Επιλέξτε Καύσιμο:</h5>
            <div class="d-flex flex-wrap gap-2">
                <a href="/?<%= selectedYear ? 'year=' + selectedYear : '' %>" class="btn <%= !selectedFuel ? 'btn-dark' : 'btn-outline-dark' %> btn-sm">Όλα τα καύσιμα</a>
                <% fuels.forEach(f => { %>
                    <a href="/?fuel=<%= f %><%= selectedYear ? '&year=' + selectedYear : '' %>" 
                       class="btn <%= selectedFuel === f ? 'btn-primary' : 'btn-outline-primary' %> btn-sm">
                        <%= f %>
                    </a>
                <% }) %>
            </div>
        </div>

        <!-- Ανάλυση Εξόδων ανά Θέρμανση για την Επιλεγμένη Χρονιά -->
        <% if (selectedYear && Object.keys(yearlyFuelBreakdown).length > 0) { %>
            <div class="card mb-4 p-3 shadow-sm border-success">
                <h4 class="text-success mb-3">📊 Ανάλυση Εξόδων για το έτος <%= selectedYear %></h4>
                <div class="row">
                    <% Object.entries(yearlyFuelBreakdown).forEach(([fuelName, cost]) => { %>
                        <div class="col-md-4 mb-2">
                            <div class="p-3 bg-light rounded border">
                                <h6 class="text-muted mb-1"><%= fuelName %></h6>
                                <h4 class="text-dark fw-bold mb-0"><%= cost.toFixed(2) %> €</h4>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        <% } %>

        <!-- Εμφάνιση Συνολικής Δαπάνης όταν επιλεγεί καύσιμο -->
        <% if (selectedFuel) { %>
            <div class="row mb-4">
                <div class="col-md-12">
                    <div class="card bg-light p-3 border-primary shadow-sm">
                        <h4>Σύνολο Δαπάνης για: <span class="text-primary"><%= selectedFuel %></span> <%= selectedYear ? '(' + selectedYear + ')' : '' %></h4>
                        <h2 class="text-danger fw-bold"><%= totalSpent.toFixed(2) %> €</h2>
                    </div>
                </div>
            </div>
        <% } %>

        <!-- Φόρμα Νέας Καταχώρησης -->
        <div class="card mb-4 p-4 shadow-sm">
            <h3 class="mb-3">➕ Νέα Καταχώρηση</h3>
            <form action="/add" method="POST" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Ημερομηνία</label>
                    <input type="date" name="date" class="form-control" required value="<%= new Date().toISOString().split('T')[0] %>">
                </div>
                <div class="col-md-4">
                    <label class="form-label">Είδος Καυσίμου</label>
                    <select name="unit" class="form-select">
                        <option value="Πέλλετ">Πέλλετ</option>
                        <option value="Ξύλα">Ξύλα</option>
                        <option value="Πετρέλαιο">Πετρέλαιο</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Ποσότητα (Kg / Λίτρα)</label>
                    <input type="number" step="any" name="amount" class="form-control" placeholder="π.χ. 500">
                </div>
                <div class="col-md-6">
                    <label class="form-label">Συνολικό Κόστος (€)</label>
                    <input type="number" step="any" name="totalCost" class="form-control" placeholder="π.χ. 150">
                </div>
                <div class="col-md-6">
                    <label class="form-label">Σημειώσεις</label>
                    <input type="text" name="notes" class="form-control" placeholder="Προαιρετικές σημειώσεις...">
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary">Αποθήκευση</button>
                </div>
            </form>
        </div>

        <!-- Ιστορικό Καταχωρήσεων (Εμφανίζεται ΜΟΝΟ όταν επιλεγεί έτος ή καύσιμο) -->
        <% if (selectedFuel || selectedYear) { %>
            <div class="card p-4 shadow-sm">
                <h3 class="mb-3">📜 Καταχωρήσεις Φίλτρου</h3>
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Ημερομηνία</th>
                                <th>Καύσιμο</th>
                                <th>Ποσότητα</th>
                                <th>Κόστος</th>
                                <th>Λεπτομέρειες</th>
                                <th>Ενέργειες</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (logs.length > 0) { %>
                                <% logs.forEach(log => { %>
                                    <tr>
                                        <td><%= new Date(log.date).toLocaleDateString('el-GR') %></td>
                                        <td><strong><%= log.unit %></strong></td>
                                        <td><%= log.amount %></td>
                                        <td><%= log.totalCost ? log.totalCost.toFixed(2) + ' €' : '-' %></td>
                                        <td><%= log.notes || '-' %></td>
                                        <td>
                                            <a href="/edit/<%= log._id %>" class="btn btn-warning btn-sm">Επεξεργασία</a>
                                            <form action="/delete/<%= log._id %>" method="POST" style="display:inline;">
                                                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Είστε σίγουρος για τη διαγραφή;');">Διαγραφή</button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" class="text-center text-muted">Δεν βρέθηκαν καταχωρήσεις για την επιλογή σας.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        <% } %>
    </div>
</body>
</html>