<!DOCTYPE html>
<html lang="el">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Καταγραφή Θέρμανσης</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light pb-5">
    <div class="container mt-4" style="max-width: 800px;">
        <h2 class="text-center mb-4 fw-bold text-primary">🔥 Καταγραφή Καυσίμων Θέρμανσης</h2>

        <!-- Συγκεντρωτικά Στοιχεία -->
        <div class="row mb-4">
            <div class="col-md-6 mb-3">
                <div class="card shadow-sm border-0 bg-white p-3">
                    <h6 class="text-muted fw-bold">Σύνολο Δαπάνης</h6>
                    <h3 class="text-danger fw-bold mb-0"><%= typeof totalCostAll !== 'undefined' ? totalCostAll.toFixed(2) : '0.00' %> €</h3>
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <div class="card shadow-sm border-0 bg-white p-3">
                    <h6 class="text-muted fw-bold">Ανά Καύσιμο</h6>
                    <% if (typeof totalsByFuel !== 'undefined' && Object.keys(totalsByFuel).length > 0) { %>
                        <ul class="list-unstyled mb-0">
                            <% Object.keys(totalsByFuel).forEach(fuel => { %>
                                <li><strong><%= fuel %>:</strong> <%= totalsByFuel[fuel].toFixed(2) %> €</li>
                            <% }) %>
                        </ul>
                    <% } else { %>
                        <p class="text-muted mb-0">Δεν υπάρχουν δεδομένα</p>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Φόρμα Καταχώρησης -->
        <div class="card shadow-sm border-0 mb-4 p-4">
            <h4 class="mb-3 text-secondary">Νέα Καταχώρηση</h4>
            <form action="/add" method="POST">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Ημερομηνία</label>
                        <input type="date" name="date" class="form-control" id="dateInput" required>
                    </div>
                    
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Είδος Καυσίμου</label>
                        <select class="form-select" id="fuelSelect" name="unit" required>
                            <option value="Πετρέλαιο">💧 Πετρέλαιο</option>
                            <option value="Πέλλετ">🟢 Πέλλετ</option>
                            <option value="Ξύλα">🪵 Ξύλα</option>
                            <option value="Άλλο">⚡ Άλλο</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Ποσότητα</label>
                        <input type="number" step="0.01" name="amount" class="form-control" placeholder="π.χ. 500 ή 1" required>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Τιμή Μονάδας (€) <small class="text-muted">(για μη-ξύλα)</small></label>
                        <input type="number" step="0.01" name="unitPrice" class="form-control" value="0" placeholder="π.χ. 1.25">
                    </div>

                    <!-- Αναλυτικά έξοδα ξύλων (Εμφανίζονται δυναμικά) -->
                    <div id="woodExpensesDiv" class="col-12" style="display: none; background: #fff3e0; padding: 15px; border-radius: 8px; border: 1px solid #ffe0b2;">
                        <h6 class="text-warning fw-bold mb-3">🛠️ Ανάλυση Εξόδων Ξύλων</h6>
                        <div class="row g-2">
                            <div class="col-md-6 mb-2">
                                <label class="form-label small fw-bold">Βενζίνη Vitara (€)</label>
                                <input type="number" step="0.01" name="vitaraGas" class="form-control" value="0">
                            </div>
                            <div class="col-md-6 mb-2">
                                <label class="form-label small fw-bold">Βενζίνη Αλυσοπρίονου (€)</label>
                                <input type="number" step="0.01" name="chainsawGas" class="form-control" value="0">
                            </div>
                            <div class="col-md-6 mb-2">
                                <label class="form-label small fw-bold">Λάδι αλυσίδας (€)</label>
                                <input type="number" step="0.01" name="chainOil" class="form-control" value="0">
                            </div>
                            <div class="col-md-6 mb-2">
                                <label class="form-label small fw-bold">Λάδι mix (€)</label>
                                <input type="number" step="0.01" name="mixOil" class="form-control" value="0">
                            </div>
                            <div class="col-md-6 mb-2">
                                <label class="form-label small fw-bold">Παρελκόμενα - Κόστος (€)</label>
                                <input type="number" step="0.01" name="accessoriesCost" class="form-control" value="0">
                            </div>
                            <div class="col-md-6 mb-2">
                                <label class="form-label small fw-bold">Περιγραφή Παρελκόμενων</label>
                                <input type="text" name="accessoriesNote" class="form-control" placeholder="π.χ. Αλλαγή αλυσίδας">
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold">Σημειώσεις</label>
                        <textarea name="notes" class="form-control" rows="2" placeholder="Προαιρετικές σημειώσεις..."></textarea>
                    </div>

                    <div class="col-12 text-end">
                        <button type="submit" class="btn btn-primary px-4 fw-bold">💾 Αποθήκευση</button>
                    </div>
                </div>
            </form>
        </div>

        <!-- Λίστα / Ιστορικό Καταχωρήσεων -->
        <div class="card shadow-sm border-0 p-4">
            <h4 class="mb-3 text-secondary">Ιστορικό Καταχωρήσεων</h4>
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Ημερομηνία</th>
                            <th>Καύσιμο</th>
                            <th>Ποσότητα</th>
                            <th>Κόστος</th>
                            <th>Λεπτομέρειες / Ανάλυση</th>
                            <th>Ενέργειες</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (typeof logs !== 'undefined' && logs.length > 0) { %>
                            <% logs.forEach(log => { %>
                                <tr>
                                    <td><%= new Date(log.date).toLocaleDateString('el-GR') %></td>
                                    <td><strong><%= log.unit %></strong></td>
                                    <td><%= log.amount %></td>
                                    <td class="text-success fw-bold"><%= log.totalCost ? log.totalCost.toFixed(2) : '0.00' %> €</td>
                                    <td>
                                        <%= log.notes %>
                                        <% if (log.unit && log.unit.includes('Ξύλα')) { %>
                                            <br><small class="text-muted">
                                                (Vitara: <%= log.vitaraGas %>€ | Αλυσοπρίονο: <%= log.chainsawGas %>€ | Λάδι αλυσ.: <%= log.chainOil %>€ | Mix: <%= log.mixOil %>€ | Παρελκ.: <%= log.accessoriesCost %>€ [<%= log.accessoriesNote %>])
                                            </small>
                                        <% } %>
                                    </td>
                                    <td>
                                        <a href="/edit/<%= log._id %>" class="btn btn-sm btn-outline-primary">✏️ Επεξεργασία</a>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="text-center text-muted">Δεν υπάρχουν καταχωρήσεις ακόμα.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Script για δυναμική εμφάνιση πεδίων ξύλων & αυτόματη ημερομηνία -->
    <script>
        // Αυτόματη συμπλήρωση σημερινής ημερομηνίας
        document.getElementById('dateInput').valueAsDate = new Date();

        const fuelSelect = document.getElementById('fuelSelect');
        const woodDiv = document.getElementById('woodExpensesDiv');

        function checkWood() {
            if (fuelSelect && fuelSelect.value.includes('Ξύλα')) {
                woodDiv.style.display = 'block';
            } else {
                woodDiv.style.display = 'none';
            }
        }

        if (fuelSelect) {
            fuelSelect.addEventListener('change', checkWood);
            checkWood(); // Εκτέλεση κατά τη φόρτωση
        }
    </script>
</body>
</html>