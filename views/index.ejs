<!DOCTYPE html>
<html lang="el">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Καταγραφή Καυσίμων Θέρμανσης</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light pb-5">
    <div class="container mt-4">
        <h1 class="mb-4 text-center fs-3">🔥 Καταγραφή Καυσίμων Θέρμανσης</h1>

        <!-- Κουμπιά Επιλογής Χρονιάς & Καυσίμου -->
        <div class="card mb-4 p-3 shadow-sm">
            <h5 class="mb-3 fs-6">📅 Επιλέξτε Χρονιά:</h5>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <a href="/?<%= selectedFuel ? 'fuel=' + selectedFuel : '' %>" class="btn <%= !selectedYear ? 'btn-secondary' : 'btn-outline-secondary' %> btn-sm">Όλα τα έτη</a>
                <% years.forEach(y => { %>
                    <a href="/?<%= selectedFuel ? 'fuel=' + selectedFuel + '&' : '' %>year=<%= y %>" 
                       class="btn <%= selectedYear == y ? 'btn-success' : 'btn-outline-success' %> btn-sm">
                        <%= y %>
                    </a>
                <% }) %>
            </div>

            <h5 class="mb-3 fs-6">🔥 Επιλέξτε Καύσιμο / Κατηγορία:</h5>
            <div class="d-flex flex-wrap gap-2">
                <a href="/?<%= selectedYear ? 'year=' + selectedYear : '' %>" class="btn <%= !selectedFuel ? 'btn-dark' : 'btn-outline-dark' %> btn-sm">Όλα</a>
                <% fuels.forEach(f => { %>
                    <a href="/?fuel=<%= encodeURIComponent(f) %><%= selectedYear ? '&year=' + selectedYear : '' %>" 
                       class="btn <%= selectedFuel === f ? 'btn-primary' : 'btn-outline-primary' %> btn-sm">
                        <%= f %>
                    </a>
                <% }) %>
            </div>
        </div>

        <!-- Ανάλυση Εξόδων & Κατανάλωσης για την Επιλεγμένη Χρονιά -->
        <% if (selectedYear && Object.keys(yearlyFuelBreakdown).length > 0) { %>
            <div class="card mb-4 p-3 shadow-sm border-success">
                <h4 class="text-success mb-3 fs-5">📊 Σύνοψη για το έτος <%= selectedYear %></h4>
                <div class="row mb-3">
                    <% Object.entries(yearlyFuelBreakdown).forEach(([fuelName, cost]) => { %>
                        <div class="col-md-4 mb-2">
                            <div class="p-3 bg-light rounded border">
                                <h6 class="text-muted mb-1"><%= fuelName %></h6>
                                <h4 class="text-dark fw-bold mb-0"><%= cost.toFixed(2) %> €</h4>
                            </div>
                        </div>
                    <% }) %>
                </div>

                <% if (selectedYear && woodTotals.total > 0) { %>
                    <hr>
                    <h5 class="text-secondary mb-2 fs-6">🪵 Αναλυτικά έξοδα Ξύλων για <%= selectedYear %>:</h5>
                    <div class="row text-center g-2">
                        <div class="col-6 col-md">
                            <span class="text-muted d-block small">Βενζίνη Vitara</span>
                            <strong><%= woodTotals.gasVitara.toFixed(2) %> €</strong>
                        </div>
                        <div class="col-6 col-md">
                            <span class="text-muted d-block small">Βενζ. Αλυσοπρ.</span>
                            <strong><%= woodTotals.gasChainsaw.toFixed(2) %> €</strong>
                        </div>
                        <div class="col-6 col-md">
                            <span class="text-muted d-block small">Λάδι Αλυσοπρ.</span>
                            <strong><%= woodTotals.oilChainsaw.toFixed(2) %> €</strong>
                        </div>
                        <div class="col-6 col-md">
                            <span class="text-muted d-block small">Λάδι Mix</span>
                            <strong><%= woodTotals.oilMix.toFixed(2) %> €</strong>
                        </div>
                        <div class="col-6 col-md">
                            <span class="text-muted d-block small">Παρελκόμενα</span>
                            <strong><%= woodTotals.accessories.toFixed(2) %> €</strong>
                        </div>
                    </div>
                <% } %>

                <% if (selectedYear && woodTotals.consumedAmount > 0) { %>
                    <div class="mt-3 p-2 bg-white rounded border text-center">
                        <span class="text-muted small">🔥 Συνολική Κατανάλωση Ξύλων (Κλούβες / Ποσότητα):</span>
                        <h4 class="text-danger fw-bold mb-0"><%= woodTotals.consumedAmount %> μονάδες</h4>
                    </div>
                <% } %>
            </div>
        <% } %>

        <!-- Εμφάνιση Συνολικής Δαπάνης όταν επιλεγεί καύσιμο -->
        <% if (selectedFuel && !selectedFuel.includes('Κατανάλωση')) { %>
            <div class="row mb-4">
                <div class="col-md-12">
                    <div class="card bg-light p-3 border-primary shadow-sm">
                        <h4>Σύνολο Δαπάνης για: <span class="text-primary"><%= selectedFuel %></span> <%= selectedYear ? '(' + selectedYear + ')' : '' %></h4>
                        <h2 class="text-danger fw-bold"><%= totalSpent.toFixed(2) %> €</h2>
                    </div>
                </div>
            </div>
        <% } %>

        <!-- Φόρμα Νέας Καταχώρησης -->
        <div class="card mb-4 p-4 shadow-sm">
            <h3 class="mb-3 fs-5">➕ Νέα Καταχώρηση</h3>
            <form action="/add" method="POST" class="row g-3" id="addForm">
                <div class="col-md-4">
                    <label class="form-label">Ημερομηνία</label>
                    <input type="date" name="date" class="form-control" required value="<%= new Date().toISOString().split('T')[0] %>">
                </div>
                <div class="col-md-4">
                    <label class="form-label">Κατηγορία / Είδος</label>
                    <select name="unit" class="form-select" id="unitSelect" onchange="toggleFormFields()">
                        <option value="Πέλλετ">Πέλλετ</option>
                        <option value="Ξύλα (Έξοδα)" selected>Ξύλα (Έξοδα)</option>
                        <option value="Ξύλα (Κατανάλωση)">Ξύλα (Κατανάλωση - Γέμισμα Κλούβας)</option>
                        <option value="Πετρέλαιο">Πετρέλαιο</option>
                    </select>
                </div>

                <!-- Κλασικά πεδία (Πέλλετ / Πετρέλαιο) -->
                <div class="col-md-4 standard-fields" style="display:none;">
                    <label class="form-label">Ποσότητα (Kg / Λίτρα)</label>
                    <input type="number" step="any" name="amount" class="form-control" value="0">
                </div>
                <div class="col-md-6 standard-fields" style="display:none;">
                    <label class="form-label">Συνολικό Κόστος (€)</label>
                    <input type="number" step="any" name="totalCost" class="form-control" value="0">
                </div>
                <div class="col-md-6 standard-fields" style="display:none;">
                    <label class="form-label">Σημειώσεις</label>
                    <input type="text" name="notes" class="form-control" placeholder="Προαιρετικές σημειώσεις...">
                </div>

                <!-- Πεδία Κατανάλωσης Ξύλων (Γέμισμα Κλούβας) -->
                <div class="col-12 consumption-fields" style="display:none;">
                    <div class="row g-3 p-3 bg-white border rounded">
                        <h5 class="text-danger mb-2 fs-6">🔥 Καταγραφή Κατανάλωσης / Γεμίσματος Κλούβας</h5>
                        <div class="col-md-6">
                            <label class="form-label">Ποσότητα / Κλούβες (π.χ. 1, 2...)</label>
                            <input type="number" step="any" name="amount" class="form-control" value="1" placeholder="π.χ. 1 κλούβα">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Σημειώσεις</label>
                            <input type="text" name="notes" class="form-control" placeholder="π.χ. Γέμισμα κλούβας">
                        </div>
                    </div>
                </div>

                <!-- Ειδικά πεδία για Έξοδα Ξύλων -->
                <div class="col-12 wood-expense-fields">
                    <div class="row g-3 p-3 bg-white border rounded">
                        <h5 class="text-success mb-2 fs-6">🪵 Αναλυτικά Έξοδα Ξύλων</h5>
                        <div class="col-md-4">
                            <label class="form-label">Όχημα (π.χ. Μπαγκαζιέρα)</label>
                            <input type="text" name="vehicle" class="form-control" placeholder="π.χ. Μπαγκαζιέρα">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Βενζίνη Vitara (€)</label>
                            <input type="number" step="any" name="gasVitara" class="form-control" value="0">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Βενζίνη Αλυσοπρίονου (€)</label>
                            <input type="number" step="any" name="gasChainsaw" class="form-control" value="0">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Λάδι αλυσοπρίονου (€)</label>
                            <input type="number" step="any" name="oilChainsaw" class="form-control" value="0">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Λάδι Mix (€)</label>
                            <input type="number" step="any" name="oilMix" class="form-control" value="0">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Παρελκόμενα (€)</label>
                            <input type="number" step="any" name="accessories" class="form-control" value="0">
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <button type="submit" class="btn btn-primary">Αποθήκευση</button>
                </div>
            </form>
        </div>

        <!-- Ιστορικό Καταχωρήσεων -->
        <% if (selectedFuel || selectedYear) { %>
            <div class="card p-4 shadow-sm">
                <h3 class="mb-3 fs-5">📜 Καταχωρήσεις Φίλτρου</h3>
                <div class="table-responsive">
                    <table class="table table-striped align-middle fs-6">
                        <thead>
                            <tr>
                                <th>Ημερομηνία</th>
                                <% if (selectedFuel && selectedFuel.includes('Ξύλα (Έξοδα)')) { %>
                                    <th>Όχημα</th>
                                    <th>Βενζ. Vitara</th>
                                    <th>Βενζ. Αλυσοπρ.</th>
                                    <th>Λάδι Αλυσοπρ.</th>
                                    <th>Λάδι Mix</th>
                                    <th>Παρελκόμενα</th>
                                    <th>Σύνολο</th>
                                <% } else if (selectedFuel && selectedFuel.includes('Ξύλα (Κατανάλωση)')) { %>
                                    <th>Κατηγορία</th>
                                    <th>Ποσότητα / Κλούβες</th>
                                    <th>Σημειώσεις</th>
                                <% } else { %>
                                    <th>Καύσιμο</th>
                                    <th>Ποσότητα</th>
                                    <th>Κόστος</th>
                                    <th>Λεπτομέρειες</th>
                                <% } %>
                                <th>Ενέργειες</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (logs.length > 0) { %>
                                <% logs.forEach(log => { %>
                                    <tr>
                                        <td><%= new Date(log.date).toLocaleDateString('el-GR') %></td>
                                        <% if (log.unit.includes('Ξύλα (Έξοδα)')) { %>
                                            <td><%= log.vehicle || '-' %></td>
                                            <td><%= (log.gasVitara || 0).toFixed(2) %> €</td>
                                            <td><%= (log.gasChainsaw || 0).toFixed(2) %> €</td>
                                            <td><%= (log.oilChainsaw || 0).toFixed(2) %> €</td>
                                            <td><%= (log.oilMix || 0).toFixed(2) %> €</td>
                                            <td><%= (log.accessories || 0).toFixed(2) %> €</td>
                                            <td><strong><%= (log.totalCost || 0).toFixed(2) %> €</strong></td>
                                        <% } else if (log.unit.includes('Ξύλα (Κατανάλωση)')) { %>
                                            <td><strong><%= log.unit %></strong></td>
                                            <td><%= log.amount %> κλούβα/ες</td>
                                            <td><%= log.notes || '-' %></td>
                                        <% } else { %>
                                            <td><strong><%= log.unit %></strong></td>
                                            <td><%= log.amount %></td>
                                            <td><%= log.totalCost ? log.totalCost.toFixed(2) + ' €' : '-' %></td>
                                            <td><%= log.notes || '-' %></td>
                                        <% } %>
                                        <td>
                                            <div class="d-flex gap-1">
                                                <a href="/edit/<%= log._id %>" class="btn btn-warning btn-sm">Επεξ.</a>
                                                <form action="/delete/<%= log._id %>" method="POST" style="display:inline;">
                                                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Είστε σίγουρος;');">Διαγ.</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="9" class="text-center text-muted">Δεν βρέθηκαν καταχωρήσεις.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        <% } %>
    </div>

    <script>
        function toggleFormFields() {
            const unit = document.getElementById('unitSelect').value;
            const woodExpenseFields = document.querySelector('.wood-expense-fields');
            const consumptionFields = document.querySelector('.consumption-fields');
            const standardFields = document.querySelectorAll('.standard-fields');

            woodExpenseFields.style.display = 'none';
            consumptionFields.style.display = 'none';
            standardFields.forEach(el => el.style.display = 'none');

            if (unit === 'Ξύλα (Έξοδα)') {
                woodExpenseFields.style.display = 'block';
            } else if (unit === 'Ξύλα (Κατανάλωση)') {
                consumptionFields.style.display = 'block';
            } else {
                standardFields.forEach(el => el.style.display = 'block');
            }
        }
        toggleFormFields();
    </script>
</body>
</html>